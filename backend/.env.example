# Copy this file to .env and fill in real values. Never commit the real .env.

SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=

SP_HOSTNAME=adam702.sharepoint.com
SP_SITE_PATH=/sites/ROSharePointAutomation
SP_FOLDER_PATH=Databricks Files
SP_OUTPUT_DIR=./data/combined

FRONTEND_ORIGIN=http://localhost:5173

# Source of the extracts: sharepoint | local. local = a folder that mirrors the
# library (files at its root, "Databricks Files" as a sub-folder), e.g. for testing.
SOURCE_MODE=sharepoint
LOCAL_SOURCE_ROOT=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Local storage (empty = backend/data and backend/mappings)
DATA_ROOT=
MAPPINGS_DIR=
# Databricks views + SAP labels for the importer (empty = backend/reference_logic)
REFERENCE_LOGIC_DIR=
# Previous versions kept per dataset before older ones go to data/archive/
SNAPSHOT_KEEP_PREVIOUS=2
SNAPSHOT_KEEP_RAW=true
HTTP_TIMEOUT=120

# Agent 1 (Rule Book agent). LLM_PROVIDER=azure | none (none = deterministic proposals only)
LLM_PROVIDER=azure
LLM_REASONING_EFFORT=medium
LLM_MAX_STEPS=25
LLM_RUN_TOKEN_BUDGET=800000
LLM_MAX_OUTPUT_TOKENS=16000
LLM_MAX_SAMPLE_ROWS=50
LLM_MAX_SAMPLE_ROWS_PER_RUN=200
# Replace sample values with pseudonyms before they are sent to the model
LLM_MASKING=false
